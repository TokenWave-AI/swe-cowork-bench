+    @staticmethod
+    def keyword_matches(keyword: str, text: str) -> bool:
+        """Match a topic token without treating e.g. weekend as the end bound."""
+        keyword = str(keyword).strip().casefold()
+        if not keyword:
+            return False
+        left = r"(?<![a-z0-9_])" if re.match(r"[a-z0-9_]", keyword[0]) else ""
+        right = r"(?![a-z0-9_])" if re.match(r"[a-z0-9_]", keyword[-1]) else ""
+        return re.search(left + re.escape(keyword) + right, text.casefold()) is not None
